# Скопируйте этот файл в .env и подставьте свои значения.
# .env не должен попадать в git — он уже добавлен в .gitignore.

# Формат: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/survey_db"

PORT=3000

# Фронтенд Vite. Можно перечислить несколько origin через запятую.
CORS_ORIGINS="http://localhost:5173"

# В production обязательно замените все три секрета случайными длинными строками.
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_SURVEY_ACCESS_SECRET="change-me-survey-access-secret"

JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
SURVEY_ACCESS_EXPIRES_IN="20m"
